<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agx_arm_graspgen</name>
  <version>0.1.0</version>
  <description>
    Grasp candidate generation package for Piper Studio.
    Starts with deterministic heuristics from perception outputs.
  </description>
  <maintainer email="maintainer@agilexrobotics.com">Agilex Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>